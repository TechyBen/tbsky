{
  "manifest_version": 3,
  "name": "skytreeone",
  "version": "0.1.0",
  "description": "A quiet PS1-style procedural forest behind Bluesky. Muted by default.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tree/*"
      ],
      "matches": [
        "https://bsky.app/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "skytreeone",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
